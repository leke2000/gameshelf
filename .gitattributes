# Keep the working tree honest about line endings: PowerShell scripts are CRLF
# (safest for Windows PowerShell 5.1), everything else is LF.
* text=auto eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.zip  binary
